-- -----------------------------------------------------------------------------
-- Image tables, owned here rather than created ad hoc by the MedSigLIP step.
--
-- Previously both were CREATE OR REPLACE ... AS SELECT inside the notebook and
-- the pipeline script, which made them full-rebuild by construction: every run
-- discarded all rows, including embeddings that cost GPU time to produce.
-- Declaring them here lets the procedures INSERT only what is missing.
--
-- EMBEDDING is VECTOR(FLOAT, {{ cfg.embed_dim }}) because google/medsiglip-448 is a {{ cfg.embed_dim }}-dim
-- dual encoder. Changing models means changing this dimension and re-embedding.
-- -----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS DICOM_BASE64_IMAGES (
    FILE_NAME            VARCHAR NOT NULL,
    FILE_SIZE            NUMBER(38,0),
    SERIES_INSTANCE_UID  VARCHAR,
    LABEL                VARCHAR,
    COLLECTION           VARCHAR,
    IMAGE_BYTES          VARCHAR,
    CONSTRAINT PK_DICOM_BASE64_IMAGES PRIMARY KEY (FILE_NAME)
)
COMMENT = 'Base64 PNG renderings at 448x448, staged for embedding. Populated incrementally by SP_CONVERT_IMAGES.';

CREATE TABLE IF NOT EXISTS DICOM_EMBEDDINGS (
    FILE_NAME            VARCHAR NOT NULL,
    FILE_SIZE            NUMBER(38,0),
    SERIES_INSTANCE_UID  VARCHAR,
    LABEL                VARCHAR,
    COLLECTION           VARCHAR,
    EMBEDDING            VECTOR(FLOAT, {{ cfg.embed_dim }}),
    CONSTRAINT PK_DICOM_EMBEDDINGS PRIMARY KEY (FILE_NAME)
)
COMMENT = 'MedSigLIP-448 image embeddings. Populated incrementally by SP_EMBED_PENDING; backs {{ cfg.search_service }}.';

-- -----------------------------------------------------------------------------
-- Migrate the derived image tables to SERIES_INSTANCE_UID, in place.
--
-- DICOM_BASE64_IMAGES and DICOM_EMBEDDINGS were keyed on the path-derived
-- SERIES_UUID. DICOM_EMBEDDINGS holds GPU-computed vectors, so this ADDs and
-- BACKFILLS the new column rather than recreating the table - rebuilding it
-- would mean paying for GPU inference again to regenerate identical vectors.
--
-- Both tables may legitimately not exist yet on a fresh account: they are
-- created by the MedSigLIP pipeline, which runs after this. Hence the
-- existence check.
-- -----------------------------------------------------------------------------
EXECUTE IMMEDIATE $$
DECLARE
    tbl        STRING;
    has_table  NUMBER;
    has_old    NUMBER;
    has_new    NUMBER;
    updated    NUMBER;
    log        STRING DEFAULT '';
    tbls ARRAY DEFAULT ARRAY_CONSTRUCT('DICOM_BASE64_IMAGES', 'DICOM_EMBEDDINGS');
BEGIN
    FOR i IN 0 TO ARRAY_SIZE(tbls) - 1 DO
        tbl := GET(tbls, i)::STRING;

        SELECT COUNT(*) INTO has_table FROM INFORMATION_SCHEMA.TABLES
        WHERE TABLE_SCHEMA = '{{ schema }}' AND TABLE_NAME = :tbl;

        IF (has_table = 0) THEN
            log := log || tbl || ': not present yet, skipped. ';
            CONTINUE;
        END IF;

        SELECT
            COUNT_IF(COLUMN_NAME = 'SERIES_UUID'),
            COUNT_IF(COLUMN_NAME = 'SERIES_INSTANCE_UID')
        INTO has_old, has_new
        FROM INFORMATION_SCHEMA.COLUMNS
        WHERE TABLE_SCHEMA = '{{ schema }}' AND TABLE_NAME = :tbl;

        IF (has_new = 0) THEN
            EXECUTE IMMEDIATE 'ALTER TABLE ' || tbl
                || ' ADD COLUMN SERIES_INSTANCE_UID VARCHAR';
        END IF;

        -- Backfill from parsed metadata. FILE_NAME is the shared key, and it is
        -- unique in DICOM_CARDIAC_METADATA, so this cannot fan out.
        EXECUTE IMMEDIATE 'UPDATE ' || tbl || ' t'
            || ' SET SERIES_INSTANCE_UID = m.SERIES_INSTANCE_UID'
            || ' FROM DICOM_CARDIAC_METADATA m'
            || ' WHERE m.FILE_NAME = t.FILE_NAME'
            || '   AND t.SERIES_INSTANCE_UID IS NULL';
        updated := SQLROWCOUNT;

        IF (has_old > 0) THEN
            EXECUTE IMMEDIATE 'ALTER TABLE ' || tbl || ' DROP COLUMN SERIES_UUID';
            log := log || tbl || ': added SERIES_INSTANCE_UID, backfilled '
                       || updated::STRING || ' rows, dropped SERIES_UUID. ';
        ELSE
            log := log || tbl || ': already migrated (backfilled '
                       || updated::STRING || ' rows). ';
        END IF;
    END FOR;

    RETURN log || 'NOTE: dicom-search/byo_search.sql must be re-run to point '
               || '{{ cfg.search_service }} at the new column.';
END;
$$;

-- -----------------------------------------------------------------------------
-- Verify
-- -----------------------------------------------------------------------------
SELECT
    c.SOURCE_NAME,
    c.STAGE_FQN,
    c.ENABLED,
    c.WINDOW_CENTER,
    c.WINDOW_WIDTH,
    COUNT(p.PREFIX) AS SCAN_PREFIXES
FROM DICOM_SOURCE_CONFIG c
LEFT JOIN DICOM_SOURCE_PREFIX p ON p.SOURCE_NAME = c.SOURCE_NAME AND p.ENABLED
GROUP BY 1, 2, 3, 4, 5
ORDER BY c.SOURCE_NAME;

SELECT COUNT(*) AS SEEDED_LABELS FROM DICOM_SERIES_LABEL_SEED;
