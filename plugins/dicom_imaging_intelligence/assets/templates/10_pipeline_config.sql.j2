        ('1.3.6.1.4.1.14519.5.2.1.99.1071.15823644866360852726843027399073', 'CTA 3.0 CE A095019',                     'covid_19_ny_sbu',     130),
        ('1.3.6.1.4.1.14519.5.2.1.7009.9004.102440903015600705598940460839', 'Chest CT Philips 202207',                'nlst',                258),
