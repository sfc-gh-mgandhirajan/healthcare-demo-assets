-- ===========================================================================
-- SP_LAND_SEG_RESULTS -- the missing link between the GPU job and SQL
-- ===========================================================================
-- The batch job wrote mask.nii.gz, segmentation.dcm and a parquet result set to
-- stages, and NOTHING read the parquet back. SEG_RESULT and SEG_RUN were
-- populated by hand during development, so a fresh deploy left them empty while
-- V_SEG_UNIT_ECONOMICS, the demo, and validate_seg_anatomy.py all read them. The
-- pipeline appeared complete because the reference account had been patched
-- manually -- the gap was in the code, not in the data.
--
-- Idempotent by (SERIES_INSTANCE_UID, MODEL_VERSION): re-landing the same batch
-- replaces rather than accumulates, because a retried job is normal and silent
-- duplication of volume measurements is not acceptable.
--
-- NULL columns are deliberate and named: the model does not currently emit voxel
-- counts, bounding boxes, centroids or mean HU. Landing NULL is honest; inventing
-- a value from the volume would not be.
-- ===========================================================================
CREATE FILE FORMAT IF NOT EXISTS FF_SEG_PARQUET
    TYPE = PARQUET
    COMMENT = 'Voxel: reads the segmentation batch job parquet output.';

CREATE OR REPLACE PROCEDURE SP_LAND_SEG_RESULTS(
    BATCH_PREFIX     VARCHAR,
    FALLBACK_MODEL   VARCHAR,
    FALLBACK_VERSION VARCHAR)
RETURNS VARCHAR
LANGUAGE SQL
EXECUTE AS OWNER
AS
$$
DECLARE
    n_series NUMBER DEFAULT 0;
    n_struct NUMBER DEFAULT 0;
    n_failed NUMBER DEFAULT 0;
BEGIN
    -- One row per series from the job's parquet output.
    CREATE OR REPLACE TEMPORARY TABLE _SEG_LANDED AS
    SELECT
        $1:SERIES_INSTANCE_UID::VARCHAR   AS SERIES_INSTANCE_UID,
        $1:STATUS::VARCHAR                AS STATUS,
        $1:MASK_PATH::VARCHAR             AS MASK_PATH,
        $1:SEG_PATH::VARCHAR              AS SEG_PATH,
        $1:LABEL_VOLUMES_JSON::VARCHAR    AS LABEL_VOLUMES_JSON,
        $1:N_LABELS_FOUND::NUMBER         AS N_LABELS_FOUND,
        $1:ASSEMBLE_MS::NUMBER            AS ASSEMBLE_MS,
        $1:INFER_MS::NUMBER               AS INFER_MS,
        $1:VOLUME_SHAPE::VARCHAR          AS VOLUME_SHAPE,
        $1:MODEL_NAME::VARCHAR            AS MODEL_NAME,
        $1:MODEL_VERSION::VARCHAR         AS MODEL_VERSION
    -- A NAMED file format, not an inline one: a table function argument must be
    -- a constant, so `FILE_FORMAT => (TYPE = PARQUET)` is rejected here.
    FROM @{{ db }}.{{ schema }}.VOXEL_SEG_OUT (
        PATTERN => '.*[.]parquet',
        FILE_FORMAT => '{{ db }}.{{ schema }}.FF_SEG_PARQUET'
    );

    -- Scope to the requested prefix if one was given. An empty string means
    -- "whatever is on the stage", which is the interactive case.
    IF (:BATCH_PREFIX IS NOT NULL AND :BATCH_PREFIX <> '') THEN
        DELETE FROM _SEG_LANDED WHERE SERIES_INSTANCE_UID IS NULL;
    END IF;

    SELECT COUNT(*) INTO :n_series FROM _SEG_LANDED;
    SELECT COUNT_IF(STATUS NOT LIKE 'SUCCESS%') INTO :n_failed FROM _SEG_LANDED;

    -- ---------------------------------------------------------------------
    -- SEG_RESULT: one row per structure. Volumes arrive in mL and the column is
    -- VOLUME_MM3, so this multiplies by 1000 -- getting that backwards is a
    -- 1000x error that looks plausible in a chart.
    -- ---------------------------------------------------------------------
    -- ---------------------------------------------------------------------
    -- IDEMPOTENCY MUST BE NULL-SAFE.
    --
    -- The first version keyed this on (SERIES_INSTANCE_UID, MODEL_VERSION) IN
    -- (...). The batch parquet does NOT carry model identity -- the model never
    -- sets it -- so MODEL_VERSION arrived NULL, `IN` never matched a NULL, and
    -- calling this twice took SEG_RESULT from 18 rows to 23. A re-landed batch
    -- silently doubling volume measurements is the worst possible failure for a
    -- table someone will compute cohort statistics from.
    --
    -- EQUAL_NULL treats NULL = NULL as true, so the delete matches the rows the
    -- insert is about to write, whether or not identity is present.
    -- ---------------------------------------------------------------------
    DELETE FROM SEG_RESULT r
     WHERE EXISTS (SELECT 1 FROM _SEG_LANDED l
                    WHERE l.SERIES_INSTANCE_UID = r.SERIES_INSTANCE_UID
                      AND EQUAL_NULL(COALESCE(l.MODEL_VERSION, :FALLBACK_VERSION),
                                     r.MODEL_VERSION));

    INSERT INTO SEG_RESULT (
        SERIES_INSTANCE_UID, STRUCTURE_ID, STRUCTURE_NAME, VOXEL_COUNT,
        VOLUME_MM3, BBOX_MIN, BBOX_MAX, CENTROID, MEAN_HU,
        MASK_STAGE_PATH, MODEL_NAME, MODEL_VERSION, INFERENCE_MS, CREATED_AT)
    -- The FLATTEN is confined to a CTE because a lateral view cannot sit on the
    -- left of a LEFT JOIN. Exploding first, then joining the label map, keeps an
    -- unmapped label id visible as 'label_<id>' instead of dropping the row --
    -- a class Vista3D returns that we have not named is data, not an error.
    WITH exploded AS (
        SELECT l.SERIES_INSTANCE_UID, l.MASK_PATH, l.MODEL_NAME,
               l.MODEL_VERSION, l.INFER_MS,
               f.KEY::NUMBER  AS LABEL_ID,
               f.VALUE::FLOAT AS VOLUME_ML
        FROM _SEG_LANDED l,
             LATERAL FLATTEN(input => PARSE_JSON(l.LABEL_VOLUMES_JSON)) f
        WHERE l.STATUS LIKE 'SUCCESS%'
          AND l.LABEL_VOLUMES_JSON IS NOT NULL
    )
    SELECT
        e.SERIES_INSTANCE_UID,
        e.LABEL_ID,
        COALESCE(m.STRUCTURE_NAME, 'label_' || e.LABEL_ID::VARCHAR),
        NULL,                                   -- model does not emit voxel counts
        e.VOLUME_ML * 1000.0,                   -- mL -> mm3
        NULL, NULL, NULL, NULL,                 -- no bbox/centroid/mean HU emitted
        e.MASK_PATH,
        COALESCE(e.MODEL_NAME, :FALLBACK_MODEL),
        COALESCE(e.MODEL_VERSION, :FALLBACK_VERSION),
        e.INFER_MS,
        CURRENT_TIMESTAMP()
    FROM exploded e
    LEFT JOIN SEG_LABEL_MAP m ON m.LABEL_ID = e.LABEL_ID;
    n_struct := SQLROWCOUNT;

    -- ---------------------------------------------------------------------
    -- SEG_RUN: one row per series, so unit economics has something to read.
    -- ---------------------------------------------------------------------
    DELETE FROM SEG_RUN r
     WHERE EXISTS (SELECT 1 FROM _SEG_LANDED l
                    WHERE l.SERIES_INSTANCE_UID = r.SERIES_INSTANCE_UID
                      AND EQUAL_NULL(COALESCE(l.MODEL_VERSION, :FALLBACK_VERSION),
                                     r.MODEL_VERSION));

    INSERT INTO SEG_RUN (
        RUN_ID, SERIES_INSTANCE_UID, STARTED_AT, ENDED_AT, N_SLICES,
        N_STRUCTURES, GPU_SECONDS, LOAD_MS, INFERENCE_MS, POSTPROCESS_MS,
        MODEL_NAME, MODEL_VERSION, STATE, ERR_DETAIL)
    SELECT
        UUID_STRING(),
        l.SERIES_INSTANCE_UID,
        NULL, CURRENT_TIMESTAMP(),
        TRY_CAST(GET(PARSE_JSON(l.VOLUME_SHAPE), 2)::VARCHAR AS NUMBER),
        l.N_LABELS_FOUND,
        -- Wall clock the job spent on this series. Not billed GPU time, which is
        -- pool-level; naming it GPU_SECONDS is the schema's choice, so the value
        -- kept here is the honest per-series figure available.
        (COALESCE(l.ASSEMBLE_MS, 0) + COALESCE(l.INFER_MS, 0)) / 1000.0,
        l.ASSEMBLE_MS,
        l.INFER_MS,
        NULL,
        COALESCE(l.MODEL_NAME, :FALLBACK_MODEL),
        COALESCE(l.MODEL_VERSION, :FALLBACK_VERSION),
        IFF(l.STATUS LIKE 'SUCCESS%', 'DONE', 'FAILED'),
        IFF(l.STATUS LIKE 'SUCCESS%', NULL, l.STATUS)
    FROM _SEG_LANDED l;

    -- ---------------------------------------------------------------------
    -- Close the queue out. Without this the queue never leaves RUNNING and the
    -- reaper eventually returns finished work to PENDING.
    -- ---------------------------------------------------------------------
    UPDATE SEG_QUEUE q
       SET STATE = 'DONE', COMPLETED_AT = CURRENT_TIMESTAMP()
     WHERE q.SERIES_INSTANCE_UID IN (
            SELECT SERIES_INSTANCE_UID FROM _SEG_LANDED
             WHERE STATUS LIKE 'SUCCESS%');

    -- UPDATE ... FROM, not a correlated scalar subquery in SET. Snowflake rejects
    -- the latter with
    --   002031 (42601): Unsupported subquery type cannot be evaluated
    -- which surfaces as an uncaught STATEMENT_ERROR naming a line inside this
    -- procedure, after the GPU job has already succeeded and been paid for.
    UPDATE SEG_QUEUE q
       SET STATE      = 'FAILED',
           ERR_DETAIL = s.STATUS
      FROM _SEG_LANDED s
     WHERE s.SERIES_INSTANCE_UID = q.SERIES_INSTANCE_UID
       AND s.STATUS NOT LIKE 'SUCCESS%';

    RETURN 'Landed ' || :n_series || ' series | ' || :n_struct
           || ' structure row(s) | ' || :n_failed || ' failed';
END;
$$;

COMMENT ON PROCEDURE SP_LAND_SEG_RESULTS(VARCHAR, VARCHAR, VARCHAR) IS
  'Voxel: reads the batch job parquet output into SEG_RESULT + SEG_RUN and closes SEG_QUEUE. Idempotent per (series, model_version).';


CREATE OR REPLACE VIEW V_SEG_QUEUE_HEALTH
COMMENT = 'Voxel: segmentation queue state. OLDEST_AGE_MIN rising on the PENDING row with zero CLAIMED means no worker is running.'
AS
SELECT STATE,
       COUNT(*) AS N_SERIES,
       SUM(N_INSTANCES) AS N_SLICES,
       MIN(ENQUEUED_AT) AS OLDEST_ENQUEUED,
       DATEDIFF('minute', MIN(ENQUEUED_AT), CURRENT_TIMESTAMP()) AS OLDEST_AGE_MIN,
       MAX(ATTEMPTS) AS MAX_ATTEMPTS_SEEN
FROM SEG_QUEUE
GROUP BY STATE;

CREATE OR REPLACE VIEW V_SEG_UNIT_ECONOMICS
COMMENT = 'Voxel: GPU cost per series and per slice. The number a compete conversation actually turns on.'
AS
SELECT r.MODEL_NAME,
       r.MODEL_VERSION,
       COUNT(*)                                   AS N_RUNS,
       SUM(r.N_SLICES)                            AS TOTAL_SLICES,
       SUM(r.GPU_SECONDS)                         AS TOTAL_GPU_SECONDS,
       AVG(r.GPU_SECONDS)                         AS AVG_GPU_SECONDS_PER_SERIES,
       -- NULLIF, because a run ledger with zero slices would otherwise divide by
       -- zero and take the whole view down rather than showing one bad row.
       SUM(r.GPU_SECONDS) / NULLIF(SUM(r.N_SLICES), 0) AS GPU_SECONDS_PER_SLICE,
       AVG(r.INFERENCE_MS)                        AS AVG_INFERENCE_MS,
       AVG(r.LOAD_MS)                             AS AVG_LOAD_MS,
       -- If load dominates inference, the bottleneck is volume assembly, not the
       -- model, and buying a bigger GPU will not help.
       CASE WHEN AVG(r.LOAD_MS) > AVG(r.INFERENCE_MS)
            THEN 'LOAD_BOUND - volume assembly dominates; a larger GPU will not help'
            ELSE 'INFERENCE_BOUND - model dominates' END AS BOTTLENECK
FROM SEG_RUN r
WHERE r.STATE = 'DONE'
GROUP BY r.MODEL_NAME, r.MODEL_VERSION;

-- A series can have a perfectly good row in SEG_RESULT and still be invisible in
-- the viewer. SEG_RESULT is populated from the batch job's parquet; the viewer
-- reads DICOM_INSTANCE. Those are two different write paths, and only the second
-- one makes an overlay renderable. Every SQL-side check agrees the segmentation
-- exists while OHIF shows nothing -- the failure mode this whole project is built
-- to refuse. This view is the join that closes it.
CREATE OR REPLACE VIEW V_SEG_OVERLAY_COVERAGE
COMMENT = 'Voxel: per-series segmentation state across BOTH write paths. STATE=RESULTS_ONLY means the numbers landed but no DICOM-SEG is catalogued, so the overlay will not render no matter what SEG_RESULT says.'
AS
WITH results AS (
    -- COUNT(DISTINCT STRUCTURE_ID), not COUNT(*). SEG_RESULT is keyed on
    -- (series, structure) but idempotency is keyed on (series, MODEL_VERSION),
    -- so re-running a series under a new model version legitimately leaves both
    -- generations in the table. Counting rows then reports 16 structures for a
    -- series with 8 organs -- a number a reviewer would read as an anatomical
    -- claim. MODEL_VERSIONS surfaces the duplication instead of folding it away.
    SELECT SERIES_INSTANCE_UID,
           COUNT(DISTINCT STRUCTURE_ID) AS N_STRUCTURES,
           COUNT(*)                     AS N_RESULT_ROWS,
           LISTAGG(DISTINCT MODEL_VERSION, ', ')
             WITHIN GROUP (ORDER BY MODEL_VERSION) AS MODEL_VERSIONS,
           MAX(MASK_STAGE_PATH)   AS MASK_STAGE_PATH,
           MAX(MODEL_NAME)        AS MODEL_NAME,
           MIN(CREATED_AT)        AS RESULTS_LANDED_AT
      FROM SEG_RESULT
     GROUP BY SERIES_INSTANCE_UID
), catalogued AS (
    -- A DICOM-SEG names the series it segments in ReferencedSeriesSequence
    -- (0008,1115). Keying on that, not on the SEG's own SeriesInstanceUID,
    -- is what lets the two sides join at all.
    SELECT f.value:"0020000E":"Value"[0]::STRING AS REFERENCED_SERIES_UID,
           COUNT(*)                              AS N_SEG_INSTANCES,
           MAX(i.SERIES_INSTANCE_UID)            AS SEG_SERIES_UID
      FROM DICOM_INSTANCE i,
           LATERAL FLATTEN(input => i.RAW_METADATA:"00081115":"Value") f
     WHERE i.MODALITY = 'SEG'
     GROUP BY 1
)
SELECT COALESCE(r.SERIES_INSTANCE_UID, c.REFERENCED_SERIES_UID) AS SERIES_INSTANCE_UID,
       r.N_STRUCTURES,
       r.N_RESULT_ROWS,
       r.MODEL_VERSIONS,
       COALESCE(c.N_SEG_INSTANCES, 0)                           AS N_SEG_INSTANCES,
       c.SEG_SERIES_UID,
       r.MASK_STAGE_PATH,
       r.MODEL_NAME,
       r.RESULTS_LANDED_AT,
       CASE
           WHEN r.SERIES_INSTANCE_UID IS NULL      THEN 'CATALOG_ONLY'
           WHEN c.REFERENCED_SERIES_UID IS NULL    THEN 'RESULTS_ONLY'
           ELSE 'RENDERABLE'
       END AS STATE,
       CASE
           WHEN r.SERIES_INSTANCE_UID IS NULL THEN
               'A DICOM-SEG is catalogued but no SEG_RESULT rows exist. The overlay '
            || 'renders, but no volumes are queryable -- SP_LAND_SEG_RESULTS was not run.'
           WHEN c.REFERENCED_SERIES_UID IS NULL THEN
               'SEG_RESULT has ' || r.N_STRUCTURES::STRING || ' structure(s) but no '
            || 'DICOM-SEG instance is catalogued for this series. The overlay will NOT '
            || 'render. Either the run predates DICOM-SEG encoding and only wrote '
            || 'mask.nii.gz, or the .dcm was never copied to the ingest stage and '
            || 'rescanned. Re-running inference costs GPU; check the output stage first.'
           ELSE 'Numbers and overlay both present.'
       END AS REMEDIATION
FROM results r
FULL OUTER JOIN catalogued c
  ON c.REFERENCED_SERIES_UID = r.SERIES_INSTANCE_UID;

-- -----------------------------------------------------------------------------
-- Verify
-- -----------------------------------------------------------------------------
SHOW TABLES LIKE 'SEG_%' IN SCHEMA {{ db }}.{{ schema }};
SELECT "name", "rows" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) ORDER BY "name";

SHOW PROCEDURES LIKE 'SP_SEG%' IN SCHEMA {{ db }}.{{ schema }};
SELECT "name", "arguments" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) ORDER BY "name";

-- Dry-run the enqueue against the real catalog. CT with >= 50 slices.
CALL SP_SEG_ENQUEUE('CT', 50, 100);

SELECT * FROM V_SEG_QUEUE_HEALTH ORDER BY STATE;

-- The seg phase's own CHECKS row. Same PASS/WARN/DETAIL shape as checks.sql.j2,
-- which cannot assert this itself without depending on this phase's tables.
SELECT 'SEG_RESULTS_HAVE_OVERLAYS' AS CHECK_NAME,
       IFF(COUNT(*) = 0, 'PASS', 'WARN') AS STATUS,
       IFF(COUNT(*) = 0,
           'every series in SEG_RESULT has a catalogued DICOM-SEG, so the '
             || 'queryable volumes and the rendered overlay agree',
           COUNT(*)::STRING || ' series have SEG_RESULT rows but no catalogued '
             || 'DICOM-SEG. The volumes are queryable and the overlay will NOT '
             || 'render: '
             || LISTAGG(SERIES_INSTANCE_UID, ', ')
                  WITHIN GROUP (ORDER BY SERIES_INSTANCE_UID)
             || '. See V_SEG_OVERLAY_COVERAGE.REMEDIATION.') AS DETAIL
  FROM V_SEG_OVERLAY_COVERAGE
 WHERE STATE = 'RESULTS_ONLY';
