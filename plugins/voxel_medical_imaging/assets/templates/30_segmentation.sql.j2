-- =============================================================================
-- 30_SEGMENTATION
--
-- Vista3D inference over series in the catalog.
--
-- =============================================================================
-- THE UNIT OF WORK IS A SERIES, NOT A FILE
--
-- Every other plane in Voxel is per-instance. Segmentation is not: Vista3D
-- consumes a 3D VOLUME, which means a whole series assembled in slice order.
-- A per-file queue would be structurally wrong -- there is no such thing as
-- segmenting one slice of a CT and having the result mean anything.
--
-- This also sets the parallelism unit. The ingest UDTF parallelizes across FILES
-- because header parsing is embarrassingly parallel. Segmentation parallelizes
-- across SERIES because a volume cannot be split without changing the answer.
--
-- =============================================================================
-- WHY A QUEUE TABLE AND NOT A TASK OVER A VIEW
--
-- GPU time is the most expensive compute in this system by a wide margin. A task
-- that re-derives "what needs segmenting" from a view on every tick will
-- re-submit work when a transient failure makes a row look pending again, and
-- GPU-seconds are the wrong thing to pay for an idempotency bug.
--
-- An explicit queue with a CLAIMED state and an attempt counter makes
-- at-most-once-per-attempt explicit and gives a retry a bounded cost.
-- =============================================================================

USE DATABASE {{ db }};
USE SCHEMA {{ schema }};
USE WAREHOUSE {{ warehouse }};

-- =============================================================================
-- Stages
--
-- Both are created here rather than in 02_STAGES because they belong to this
-- phase: an account that never deploys segmentation has no use for either.
--
-- These were previously assumed to exist and were not created by any phase, so a
-- deploy into a clean account failed at run_batch() with
--   002003 (02000): Stage 'VOXEL_SEG_OUT' does not exist or not authorized
-- reported against the model, not the stage.
--
-- INTERNAL, not external: register_vista3d.py reaches VOXEL_MODELS with
-- session.file.get, which is a GET, and GET is unsupported on external stages
-- (091003). The same constraint is why frames are read from the pread stage.
-- Staging the bundle here is also what lets inference run with NO external access
-- integration at all.
-- =============================================================================
CREATE STAGE IF NOT EXISTS VOXEL_SEG_OUT
    ENCRYPTION = (TYPE = 'SNOWFLAKE_SSE')
    DIRECTORY  = (ENABLE = TRUE)
    COMMENT    = 'Voxel: Vista3D batch output -- NIfTI mask, DICOM-SEG, and the _batch_out parquet manifest that SP_LAND_SEG_RESULTS reads.';

CREATE STAGE IF NOT EXISTS VOXEL_MODELS
    ENCRYPTION = (TYPE = 'SNOWFLAKE_SSE')
    DIRECTORY  = (ENABLE = TRUE)
    COMMENT    = 'Voxel: staged model bundles (vista3d). Staged once so inference needs no external access integration.';

-- =============================================================================
-- Queue
-- =============================================================================
CREATE TABLE IF NOT EXISTS SEG_QUEUE (
    SERIES_INSTANCE_UID VARCHAR       NOT NULL,
    STUDY_INSTANCE_UID  VARCHAR,
    MODALITY            VARCHAR,
    N_INSTANCES         NUMBER(38,0),
    STATE               VARCHAR       NOT NULL DEFAULT 'PENDING',
    ATTEMPTS            NUMBER(38,0)  NOT NULL DEFAULT 0,
    PRIORITY            NUMBER(38,0)  NOT NULL DEFAULT 100,
    CLAIMED_BY          VARCHAR,
    CLAIMED_AT          TIMESTAMP_LTZ,
    ENQUEUED_AT         TIMESTAMP_LTZ DEFAULT CURRENT_TIMESTAMP(),
    COMPLETED_AT        TIMESTAMP_LTZ,
    ERR_CODE            VARCHAR,
    ERR_DETAIL          VARCHAR,
    CONSTRAINT PK_SEG_QUEUE PRIMARY KEY (SERIES_INSTANCE_UID),
    CONSTRAINT CK_SEG_STATE CHECK (
        STATE IN ('PENDING', 'CLAIMED', 'DONE', 'FAILED', 'SKIPPED'))
)
COMMENT = 'Voxel: series-level segmentation work queue. Explicit states because GPU-seconds are the wrong currency for an idempotency bug.';

-- =============================================================================
-- Results
--
-- The mask itself is NOT stored in this table. A 512x512x500 uint8 label volume is
-- ~131 MB; a VARIANT column holding that would make every metadata query on this
-- table read it. The volume goes to a stage, this table holds the POINTER plus the
-- per-structure measurements, which is what queries actually filter and aggregate
-- on.
-- =============================================================================
CREATE TABLE IF NOT EXISTS SEG_RESULT (
    SERIES_INSTANCE_UID VARCHAR       NOT NULL,
    STRUCTURE_ID        NUMBER(38,0)  NOT NULL,
    STRUCTURE_NAME      VARCHAR       NOT NULL,
    VOXEL_COUNT         NUMBER(38,0),
    VOLUME_MM3          FLOAT,
    -- Bounding box in voxel index space, so it is meaningful without also
    -- carrying the affine. Patient-space coordinates would require the full
    -- ImagePositionPatient/ImageOrientationPatient transform to interpret.
    BBOX_MIN            VARIANT,
    BBOX_MAX            VARIANT,
    CENTROID            VARIANT,
    MEAN_HU             FLOAT,
    MASK_STAGE_PATH     VARCHAR,
    MODEL_NAME          VARCHAR,
    MODEL_VERSION       VARCHAR,
    INFERENCE_MS        NUMBER(38,0),
    CREATED_AT          TIMESTAMP_LTZ DEFAULT CURRENT_TIMESTAMP(),
    CONSTRAINT PK_SEG_RESULT PRIMARY KEY (SERIES_INSTANCE_UID, STRUCTURE_ID)
)
COMMENT = 'Voxel: per-structure segmentation measurements. The label volume lives on a stage; this holds the pointer and the numbers queries actually use.';

-- =============================================================================
-- Run ledger
--
-- Separate from SEG_RESULT because one run produces MANY structure rows, and the
-- cost/timing attribution belongs to the RUN. Putting GPU seconds on every
-- structure row would double-count it 100-fold when aggregating.
-- =============================================================================
CREATE TABLE IF NOT EXISTS SEG_RUN (
    RUN_ID              VARCHAR       DEFAULT UUID_STRING(),
    SERIES_INSTANCE_UID VARCHAR       NOT NULL,
    STARTED_AT          TIMESTAMP_LTZ,
    ENDED_AT            TIMESTAMP_LTZ,
    N_SLICES            NUMBER(38,0),
    N_STRUCTURES        NUMBER(38,0),
    GPU_SECONDS         FLOAT,
    LOAD_MS             NUMBER(38,0),
    INFERENCE_MS        NUMBER(38,0),
    POSTPROCESS_MS      NUMBER(38,0),
    MODEL_NAME          VARCHAR,
    MODEL_VERSION       VARCHAR,
    STATE               VARCHAR,
    ERR_DETAIL          VARCHAR,
    CONSTRAINT PK_SEG_RUN PRIMARY KEY (RUN_ID)
)
COMMENT = 'Voxel: one row per segmentation run. GPU seconds live here, not on structure rows, so aggregation does not multiply cost by structure count.';

-- =============================================================================
-- V_SERIES_GEOMETRY
--
-- Distinguishes a TRUE 3D VOLUME from a 4D / multi-phase acquisition.
--
-- =============================================================================
-- WHY THIS IS A CORRECTNESS CONTROL, NOT A NICETY
--
-- IS_HETEROGENEOUS (in V_DICOM_SERIES) catches mixed transfer syntaxes and mixed
-- image dimensions. It does NOT catch a series whose slices occupy the SAME
-- spatial positions more than once -- which is exactly what a gated cardiac CTA or
-- a perfusion acquisition looks like.
--
-- Observed on the IDC corpus:
--   'SS Segment 30-75 BPM 0.625mm'  570 instances / 57 positions = 10 PHASES
--   'CTA 3.000 CE'                  130 instances /  1 position  = dynamic series
--
-- Assembling either into a volume by sorting on position produces an incoherent
-- stack, and Vista3D would return a CONFIDENTLY WRONG segmentation rather than an
-- error. Wrong-but-plausible is the failure mode this whole project is trying to
-- design against, and the segmentation queue was walking straight into it.
--
-- These datasets also lack the standard temporal discriminators
-- (TriggerTime 0018,1060 / TemporalPositionIdentifier 0020,0100 / a varying
-- AcquisitionNumber), so they cannot be split into per-phase volumes
-- automatically either. The honest handling is to EXCLUDE them and say why.
-- =============================================================================
CREATE OR REPLACE VIEW V_SERIES_GEOMETRY
COMMENT = 'Voxel: classifies each series as VOLUME_3D or MULTIPHASE_4D by comparing instance count to distinct slice positions. Only VOLUME_3D is safe to segment.'
AS
WITH pos AS (
    SELECT SERIES_INSTANCE_UID,
           MODALITY,
           SERIES_DESCRIPTION,
           -- Third component of ImagePositionPatient is the position along the
           -- normal for axial acquisitions. Stored backslash-delimited.
           TRY_TO_DOUBLE(SPLIT_PART(IMAGE_POSITION_PATIENT, '\\', 3)) AS Z
    FROM DICOM_INSTANCE
),
agg AS (
    SELECT SERIES_INSTANCE_UID,
           ANY_VALUE(MODALITY)           AS MODALITY,
           ANY_VALUE(SERIES_DESCRIPTION) AS SERIES_DESCRIPTION,
           COUNT(*)                      AS N_INSTANCES,
           COUNT(DISTINCT Z)             AS N_POSITIONS,
           SUM(IFF(Z IS NULL, 1, 0))     AS N_NULL_POSITION
    FROM pos
    GROUP BY SERIES_INSTANCE_UID
)
SELECT SERIES_INSTANCE_UID,
       MODALITY,
       SERIES_DESCRIPTION,
       N_INSTANCES,
       N_POSITIONS,
       N_NULL_POSITION,
       ROUND(N_INSTANCES / NULLIF(N_POSITIONS, 0), 2) AS INSTANCES_PER_POSITION,
       CASE
           WHEN N_NULL_POSITION > 0        THEN 'NO_POSITION'
           WHEN N_POSITIONS = 0            THEN 'NO_POSITION'
           WHEN N_INSTANCES = N_POSITIONS  THEN 'VOLUME_3D'
           ELSE 'MULTIPHASE_4D'
       END AS GEOMETRY,
       (N_NULL_POSITION = 0 AND N_POSITIONS > 1 AND N_INSTANCES = N_POSITIONS)
           AS IS_SEGMENTABLE_VOLUME
FROM agg;

-- =============================================================================
-- Enqueue
--
-- Only enqueues series that are actually segmentable, and records WHY when they
-- are not -- as SKIPPED with a reason rather than silently omitting them. A series
-- missing from the queue with no explanation is indistinguishable from a bug.
-- =============================================================================
CREATE OR REPLACE PROCEDURE SP_SEG_ENQUEUE(
    MODALITY_FILTER VARCHAR,
    MIN_SLICES      NUMBER,
    BATCH_LIMIT     NUMBER)
RETURNS VARCHAR
LANGUAGE SQL
COMMENT = 'Voxel: enqueue segmentable series. Requires VOLUME_3D geometry. Records SKIPPED with a reason rather than silently omitting.'
AS
$$
DECLARE
    n_new     NUMBER DEFAULT 0;
    n_skipped NUMBER DEFAULT 0;
BEGIN
    -- Segmentable: enough slices to be a volume, HOMOGENEOUS geometry, TRUE 3D
    -- positional integrity, and every instance servable.
    --
    -- IS_HETEROGENEOUS catches mixed transfer syntax and dimensions.
    -- IS_SEGMENTABLE_VOLUME catches 4D / multi-phase, which the former does not.
    -- Both are required; either alone lets a wrong-but-plausible volume through.
    MERGE INTO SEG_QUEUE q
    USING (
        SELECT s.SERIES_INSTANCE_UID,
               s.STUDY_INSTANCE_UID,
               s.MODALITY,
               s.INSTANCE_COUNT
        FROM {{ db }}.{{ schema }}.V_DICOM_SERIES s
        JOIN {{ db }}.{{ schema }}.V_SERIES_GEOMETRY g
          ON g.SERIES_INSTANCE_UID = s.SERIES_INSTANCE_UID
        WHERE (:MODALITY_FILTER IS NULL OR s.MODALITY = :MODALITY_FILTER)
          AND s.INSTANCE_COUNT >= :MIN_SLICES
          AND NOT s.IS_HETEROGENEOUS
          AND g.IS_SEGMENTABLE_VOLUME
          -- Every instance must be servable. NOT EXISTS an unservable one.
          AND NOT EXISTS (
              SELECT 1
              FROM {{ db }}.{{ schema }}.V_FRAME_COVERAGE c
              WHERE c.SERIES_INSTANCE_UID = s.SERIES_INSTANCE_UID
                AND (NOT c.IS_SERVABLE OR c.IS_STALE))
        ORDER BY s.INSTANCE_COUNT DESC
        LIMIT :BATCH_LIMIT
    ) src
    ON q.SERIES_INSTANCE_UID = src.SERIES_INSTANCE_UID
    -- Do NOT reset a DONE or CLAIMED row. Re-enqueueing completed work is how a
    -- scheduled task quietly spends a GPU budget twice.
    WHEN NOT MATCHED THEN INSERT
        (SERIES_INSTANCE_UID, STUDY_INSTANCE_UID, MODALITY, N_INSTANCES, STATE)
        VALUES (src.SERIES_INSTANCE_UID, src.STUDY_INSTANCE_UID,
                src.MODALITY, src.INSTANCE_COUNT, 'PENDING');

    n_new := SQLROWCOUNT;

    -- Record the rejects with a reason, so "why is this series not segmented" has
    -- an answer in the table rather than requiring someone to re-derive the
    -- predicate by hand.
    MERGE INTO SEG_QUEUE q
    USING (
        SELECT s.SERIES_INSTANCE_UID, s.STUDY_INSTANCE_UID, s.MODALITY,
               s.INSTANCE_COUNT,
               CASE
                   WHEN s.INSTANCE_COUNT < :MIN_SLICES
                       THEN 'TOO_FEW_SLICES: ' || s.INSTANCE_COUNT || ' < ' || :MIN_SLICES
                   WHEN s.IS_HETEROGENEOUS
                       THEN 'HETEROGENEOUS_GEOMETRY: mixed transfer syntax or dimensions; '
                         || 'a volume assembled from these would segment wrongly rather than fail'
                   WHEN g.GEOMETRY = 'MULTIPHASE_4D'
                       THEN 'MULTIPHASE_4D: ' || g.N_INSTANCES || ' instances across only '
                         || g.N_POSITIONS || ' slice position(s) (~'
                         || g.INSTANCES_PER_POSITION || ' phases). Not a single 3D volume; '
                         || 'segmenting it would produce a confidently wrong result'
                   WHEN g.GEOMETRY = 'NO_POSITION'
                       THEN 'NO_POSITION: ImagePositionPatient missing, so slice order '
                         || 'cannot be established'
                   ELSE 'UNSERVABLE_INSTANCES: frame plane incomplete or stale'
               END AS REASON
        FROM {{ db }}.{{ schema }}.V_DICOM_SERIES s
        JOIN {{ db }}.{{ schema }}.V_SERIES_GEOMETRY g
          ON g.SERIES_INSTANCE_UID = s.SERIES_INSTANCE_UID
        WHERE (:MODALITY_FILTER IS NULL OR s.MODALITY = :MODALITY_FILTER)
          AND (s.INSTANCE_COUNT < :MIN_SLICES
               OR s.IS_HETEROGENEOUS
               OR NOT g.IS_SEGMENTABLE_VOLUME
               OR EXISTS (
                   SELECT 1
                   FROM {{ db }}.{{ schema }}.V_FRAME_COVERAGE c
                   WHERE c.SERIES_INSTANCE_UID = s.SERIES_INSTANCE_UID
                     AND (NOT c.IS_SERVABLE OR c.IS_STALE)))
        LIMIT :BATCH_LIMIT
    ) src
    ON q.SERIES_INSTANCE_UID = src.SERIES_INSTANCE_UID
    WHEN NOT MATCHED THEN INSERT
        (SERIES_INSTANCE_UID, STUDY_INSTANCE_UID, MODALITY, N_INSTANCES,
         STATE, ERR_CODE, ERR_DETAIL)
        VALUES (src.SERIES_INSTANCE_UID, src.STUDY_INSTANCE_UID, src.MODALITY,
                src.INSTANCE_COUNT, 'SKIPPED', 'NOT_SEGMENTABLE', src.REASON);

    n_skipped := SQLROWCOUNT;

    RETURN 'enqueued ' || n_new || ' series, skipped ' || n_skipped
        || ' as not segmentable';
END;
$$;

-- =============================================================================
-- Claim
--
-- Atomic claim so two workers cannot take the same series. The UPDATE ... WHERE
-- STATE = 'PENDING' is the lock; Snowflake's statement-level atomicity makes the
-- read-modify-write safe without an explicit transaction.
--
-- MAX_ATTEMPTS is enforced HERE rather than by the worker. A worker that crashes
-- before it can record a failure would otherwise retry forever, and each retry
-- costs GPU time.
-- =============================================================================
CREATE OR REPLACE PROCEDURE SP_SEG_CLAIM(WORKER_ID VARCHAR, MAX_ATTEMPTS NUMBER)
RETURNS TABLE (SERIES_INSTANCE_UID VARCHAR, N_INSTANCES NUMBER, ATTEMPTS NUMBER)
LANGUAGE SQL
COMMENT = 'Voxel: atomically claim one PENDING series. Attempt ceiling enforced here, not in the worker, so a crashed worker cannot retry forever.'
AS
$$
DECLARE
    res RESULTSET;
BEGIN
    -- Retire anything that has exhausted its attempts before claiming, so an
    -- exhausted row cannot be picked up again.
    UPDATE SEG_QUEUE
       SET STATE = 'FAILED',
           ERR_CODE = 'MAX_ATTEMPTS_EXCEEDED',
           ERR_DETAIL = 'attempts reached ' || :MAX_ATTEMPTS || ' without success'
     WHERE STATE = 'PENDING' AND ATTEMPTS >= :MAX_ATTEMPTS;

    UPDATE SEG_QUEUE
       SET STATE = 'CLAIMED',
           CLAIMED_BY = :WORKER_ID,
           CLAIMED_AT = CURRENT_TIMESTAMP(),
           ATTEMPTS = ATTEMPTS + 1
     WHERE SERIES_INSTANCE_UID = (
         SELECT SERIES_INSTANCE_UID
         FROM SEG_QUEUE
         WHERE STATE = 'PENDING' AND ATTEMPTS < :MAX_ATTEMPTS
         ORDER BY PRIORITY, N_INSTANCES DESC
         LIMIT 1);

    res := (SELECT SERIES_INSTANCE_UID, N_INSTANCES, ATTEMPTS
            FROM SEG_QUEUE
            WHERE CLAIMED_BY = :WORKER_ID AND STATE = 'CLAIMED'
            ORDER BY CLAIMED_AT DESC
            LIMIT 1);
    RETURN TABLE(res);
END;
$$;

-- =============================================================================
-- Reap abandoned claims
--
-- A worker killed mid-run leaves a row CLAIMED forever. Without this the queue
-- silently drains to nothing and never completes -- which looks exactly like
-- "segmentation finished".
-- =============================================================================
CREATE OR REPLACE PROCEDURE SP_SEG_REAP(STALE_MINUTES NUMBER)
RETURNS VARCHAR
LANGUAGE SQL
COMMENT = 'Voxel: return claims older than STALE_MINUTES to PENDING. Without this a killed worker makes the queue look finished.'
AS
$$
DECLARE
    n NUMBER DEFAULT 0;
BEGIN
    UPDATE SEG_QUEUE
       SET STATE = 'PENDING', CLAIMED_BY = NULL, CLAIMED_AT = NULL
     WHERE STATE = 'CLAIMED'
       AND CLAIMED_AT < DATEADD('minute', -1 * :STALE_MINUTES, CURRENT_TIMESTAMP());
    n := SQLROWCOUNT;
    RETURN 'returned ' || n || ' abandoned claim(s) to PENDING';
END;
$$;

-- =============================================================================
-- Observability
-- =============================================================================
-- ===========================================================================
-- SEG_LABEL_MAP -- Vista3D label id to anatomy, in SQL
-- ===========================================================================
-- The mapping from Vista3D's integer class ids to organ names and SNOMED codes
-- previously existed ONLY as a dict inside the Python model. That made it
-- impossible for SQL to interpret the model's own output, which is one reason the
-- results were never landed: LABEL_VOLUMES_JSON is keyed {"1": 372.4}, and
-- nothing on the database side knew that 1 means liver.
--
-- Codes are SNOMED CT, matching what the DICOM-SEG writer emits, so the segment
-- coding in the DICOM object and the coding in the catalog cannot drift.
-- ===========================================================================
CREATE OR REPLACE TABLE SEG_LABEL_MAP (
    LABEL_ID      NUMBER      NOT NULL PRIMARY KEY,
    STRUCTURE_NAME VARCHAR    NOT NULL,
    SNOMED_CODE   VARCHAR     NOT NULL
)
COMMENT = 'Voxel: Vista3D class id -> anatomy + SNOMED CT. Mirrors SEG_LABELS in vista3d_model.py.';

