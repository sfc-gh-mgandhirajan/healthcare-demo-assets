-- VW_ADDRESSABLE_BRIDGE — panel cBridge: the addressable prize by spend lever (one owner per dollar).
-- Bounded passthrough of MDL_ADDRESSABLE_BRIDGE.
CREATE OR REPLACE VIEW {{ target('VW_ADDRESSABLE_BRIDGE') }} AS
SELECT
  LEVER_ORDER,
  LEVER_KEY,
  LEVER_NAME,
  STATUS,
  ROUND(GROSS_POOL, 2)          AS GROSS_POOL,
  CAPTURE_RATE,
  ROUND(ADDRESSABLE_AMOUNT, 2)  AS ADDRESSABLE_AMOUNT,
  PCT_OF_TOTAL,
  RATIONALE
FROM {{ target('MDL_ADDRESSABLE_BRIDGE') }}
ORDER BY ADDRESSABLE_AMOUNT DESC;
