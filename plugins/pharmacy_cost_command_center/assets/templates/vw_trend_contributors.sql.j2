-- VW_TREND_CONTRIBUTORS — panel cContrib: dollars added YoY by therapeutic class (ranked by $
-- contribution to the trend), with the dominant P/V/M driver per class. Bounded: MDL_TREND_DRIVERS.
CREATE OR REPLACE VIEW {{ target('VW_TREND_CONTRIBUTORS') }} AS
SELECT
  THERAPEUTIC_CLASS,
  ROUND(TOTAL_CHANGE, 2)   AS DOLLARS_ADDED_YOY,
  PCT_CHANGE               AS YOY_GROWTH_PCT,
  ROUND(VOLUME_EFFECT, 2)  AS VOLUME_EFFECT,
  ROUND(PRICE_EFFECT, 2)   AS PRICE_EFFECT,
  ROUND(MIX_EFFECT, 2)     AS MIX_EFFECT,
  CASE GREATEST(COALESCE(VOLUME_EFFECT,0), COALESCE(PRICE_EFFECT,0), COALESCE(MIX_EFFECT,0))
    WHEN COALESCE(VOLUME_EFFECT,0) THEN 'Volume'
    WHEN COALESCE(PRICE_EFFECT,0)  THEN 'Price'
    ELSE 'Mix' END         AS DOMINANT_DRIVER,
  DRIVER_RANK
FROM {{ target('MDL_TREND_DRIVERS') }}
WHERE TOTAL_CHANGE > 0
ORDER BY TOTAL_CHANGE DESC
LIMIT 12;
