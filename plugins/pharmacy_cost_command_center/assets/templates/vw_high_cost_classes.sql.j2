-- VW_HIGH_COST_CLASSES — panel cHiCost: top therapeutic classes by current-year net spend with YoY
-- growth label. Bounded: reads MDL_TREND_DRIVERS.
CREATE OR REPLACE VIEW {{ target('VW_HIGH_COST_CLASSES') }} AS
SELECT
  THERAPEUTIC_CLASS,
  ROUND(NET_SPEND_CURRENT, 2)  AS NET_SPEND_CURRENT,
  ROUND(NET_SPEND_PRIOR, 2)    AS NET_SPEND_PRIOR,
  PCT_CHANGE                   AS YOY_GROWTH_PCT
FROM {{ target('MDL_TREND_DRIVERS') }}
WHERE NET_SPEND_CURRENT > 0
ORDER BY NET_SPEND_CURRENT DESC
LIMIT 12;
