-- VW_FORMULARY_LEAKAGE — panel cOffForm: non-preferred pharmacy utilization (steerable to preferred
-- in-class alternatives) by drug, current 12 months. Bounded: reads DENORM_DRUG_SPEND_DETAIL.
CREATE OR REPLACE VIEW {{ target('VW_FORMULARY_LEAKAGE') }} AS
SELECT
  DRUG_NAME,
  MAX(THERAPEUTIC_CLASS)         AS THERAPEUTIC_CLASS,
  ROUND(SUM(NET_AMOUNT), 2)      AS STEERABLE_NET_SPEND,
  COUNT(*)                       AS CLAIM_LINES
FROM {{ target('DENORM_DRUG_SPEND_DETAIL') }}
WHERE PERIOD_BUCKET = 'CURRENT_12'
  AND BENEFIT_TYPE IN ('TRADITIONAL_RX','SPECIALTY_PHARMACY')
  AND COALESCE(PREFERRED_FLAG, FALSE) = FALSE
GROUP BY DRUG_NAME
ORDER BY STEERABLE_NET_SPEND DESC
LIMIT 15;
