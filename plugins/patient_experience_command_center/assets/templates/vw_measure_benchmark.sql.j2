-- VW_MEASURE_BENCHMARK — s2 cComm (and general): per-HCAHPS-measure top-box vs house target
-- (PERFORMANCE_TARGET) and national median (SURVEY_BENCHMARK). One row per measure.
CREATE OR REPLACE VIEW {{ target('VW_MEASURE_BENCHMARK') }} AS
WITH tb AS (
  SELECT
    AVG(IFF(TOPBOX_H_COMP_1,1,0))*100     AS H_COMP_1,
    AVG(IFF(TOPBOX_H_COMP_2,1,0))*100     AS H_COMP_2,
    AVG(IFF(TOPBOX_H_COMP_3,1,0))*100     AS H_COMP_3,
    AVG(IFF(TOPBOX_H_COMP_5,1,0))*100     AS H_COMP_5,
    AVG(IFF(TOPBOX_H_COMP_6,1,0))*100     AS H_COMP_6,
    AVG(IFF(TOPBOX_H_COMP_7,1,0))*100     AS H_COMP_7,
    AVG(IFF(TOPBOX_H_CLEAN_HSP,1,0))*100  AS H_CLEAN_HSP,
    AVG(IFF(TOPBOX_H_QUIET_HSP,1,0))*100  AS H_QUIET_HSP,
    AVG(IFF(TOPBOX_H_HSP_RATING,1,0))*100 AS H_HSP_RATING,
    AVG(IFF(TOPBOX_H_RECMND,1,0))*100     AS H_RECMND
  FROM {{ target('DENORM_SURVEY_RESPONSE_DETAIL') }}
),
up AS (
  SELECT MEASURE_CODE, TOPBOX_PCT FROM tb
  UNPIVOT (TOPBOX_PCT FOR MEASURE_CODE IN
    (H_COMP_1,H_COMP_2,H_COMP_3,H_COMP_5,H_COMP_6,H_COMP_7,H_CLEAN_HSP,H_QUIET_HSP,H_HSP_RATING,H_RECMND))
)
SELECT
  up.MEASURE_CODE,
  CASE up.MEASURE_CODE
    WHEN 'H_COMP_1' THEN 'Nurse communication' WHEN 'H_COMP_2' THEN 'Doctor communication'
    WHEN 'H_COMP_3' THEN 'Staff responsiveness' WHEN 'H_COMP_5' THEN 'Communication about medicines'
    WHEN 'H_COMP_6' THEN 'Discharge information' WHEN 'H_COMP_7' THEN 'Care transition'
    WHEN 'H_CLEAN_HSP' THEN 'Cleanliness' WHEN 'H_QUIET_HSP' THEN 'Quietness'
    WHEN 'H_HSP_RATING' THEN 'Overall rating 9-10' WHEN 'H_RECMND' THEN 'Would recommend' END AS MEASURE_NAME,
  ROUND(up.TOPBOX_PCT, 1) AS TOPBOX_PCT,
  pt.{{ c('PT_TARGET_TOPBOX') }} AS TARGET_TOPBOX,
  sb.{{ c('SB_NATIONAL_AVG_TOPBOX') }} AS NATIONAL_AVG_TOPBOX
FROM up
LEFT JOIN {{ tbl('PT_MEASURE_CODE') }} pt
  ON pt.{{ c('PT_MEASURE_CODE') }} = up.MEASURE_CODE AND pt.{{ c('PT_ENTITY_LEVEL') }} = 'HOUSE'
LEFT JOIN {{ tbl('SB_MEASURE_CODE') }} sb ON sb.{{ c('SB_MEASURE_CODE') }} = up.MEASURE_CODE;
