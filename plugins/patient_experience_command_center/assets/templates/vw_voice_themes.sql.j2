-- VW_VOICE_THEMES — Voice-of-Patient: net sentiment + volume by experience theme.
CREATE OR REPLACE VIEW {{ target('VW_VOICE_THEMES') }} AS
SELECT THEME, JOURNEY_STAGE, MENTIONS, AVG_SENTIMENT, PCT_POSITIVE, PCT_NEUTRAL, PCT_NEGATIVE, NET_SENTIMENT
FROM {{ target('MDL_VOICE_SENTIMENT') }}
ORDER BY NET_SENTIMENT;
