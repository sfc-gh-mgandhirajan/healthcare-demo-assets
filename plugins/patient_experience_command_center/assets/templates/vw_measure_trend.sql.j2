-- VW_MEASURE_TREND — s2 cCommTrend (and general): per-HCAHPS-measure top-box over the last 5 quarters
-- (real quarterly momentum from DISCHARGE_QUARTER). One row per measure x quarter.
CREATE OR REPLACE VIEW {{ target('VW_MEASURE_TREND') }} AS
WITH base AS (
  SELECT DISCHARGE_QUARTER,
    AVG(IFF(TOPBOX_H_COMP_1,1,0))*100     AS H_COMP_1,
    AVG(IFF(TOPBOX_H_COMP_2,1,0))*100     AS H_COMP_2,
    AVG(IFF(TOPBOX_H_COMP_3,1,0))*100     AS H_COMP_3,
    AVG(IFF(TOPBOX_H_COMP_5,1,0))*100     AS H_COMP_5,
    AVG(IFF(TOPBOX_H_COMP_6,1,0))*100     AS H_COMP_6,
    AVG(IFF(TOPBOX_H_COMP_7,1,0))*100     AS H_COMP_7,
    AVG(IFF(TOPBOX_H_CLEAN_HSP,1,0))*100  AS H_CLEAN_HSP,
    AVG(IFF(TOPBOX_H_QUIET_HSP,1,0))*100  AS H_QUIET_HSP,
    AVG(IFF(TOPBOX_H_HSP_RATING,1,0))*100 AS H_HSP_RATING,
    AVG(IFF(TOPBOX_H_RECMND,1,0))*100     AS H_RECMND
  FROM {{ target('DENORM_SURVEY_RESPONSE_DETAIL') }}
  WHERE DISCHARGE_QUARTER >= DATEADD('quarter', -4,
    (SELECT MAX(DISCHARGE_QUARTER) FROM {{ target('DENORM_SURVEY_RESPONSE_DETAIL') }}))
  GROUP BY DISCHARGE_QUARTER
)
SELECT DISCHARGE_QUARTER AS QUARTER, MEASURE_CODE, ROUND(TOPBOX_PCT, 1) AS TOPBOX_PCT
FROM base
UNPIVOT (TOPBOX_PCT FOR MEASURE_CODE IN
  (H_COMP_1,H_COMP_2,H_COMP_3,H_COMP_5,H_COMP_6,H_COMP_7,H_CLEAN_HSP,H_QUIET_HSP,H_HSP_RATING,H_RECMND))
ORDER BY QUARTER, MEASURE_CODE;
