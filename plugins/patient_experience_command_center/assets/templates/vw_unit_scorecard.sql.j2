-- VW_UNIT_SCORECARD — per-unit scorecard: star + composite + recommend + risk, for the unit grid.
CREATE OR REPLACE VIEW {{ target('VW_UNIT_SCORECARD') }} AS
WITH surv AS (
  SELECT UNIT_ID, ANY_VALUE(UNIT_NAME) AS UNIT_NAME, ANY_VALUE(SERVICE_LINE) AS SERVICE_LINE,
         COUNT(*) AS N_RESPONSES, ROUND(AVG(IFF(TOPBOX_H_RECMND,1,0))*100,1) AS RECOMMEND_TOPBOX_PCT
  FROM {{ target('DENORM_SURVEY_RESPONSE_DETAIL') }} GROUP BY UNIT_ID
),
rsk AS (
  SELECT UNIT_ID, ROUND(AVG(RISK_SCORE),3) AS AVG_DETRACTOR_RISK, COUNT_IF(RISK_TIER='HIGH') AS HIGH_RISK_ENCOUNTERS
  FROM {{ target('MDL_DISSAT_RISK') }} GROUP BY UNIT_ID
)
SELECT
  st.ENTITY_ID AS UNIT_ID, surv.UNIT_NAME, surv.SERVICE_LINE,
  st.COMPOSITE_TOPBOX, st.STAR_LEVEL, st.PTS_TO_NEXT_STAR,
  surv.RECOMMEND_TOPBOX_PCT, surv.N_RESPONSES,
  rsk.AVG_DETRACTOR_RISK, rsk.HIGH_RISK_ENCOUNTERS
FROM {{ target('MDL_STAR_RATING') }} st
JOIN surv ON surv.UNIT_ID::VARCHAR = st.ENTITY_ID
LEFT JOIN rsk ON rsk.UNIT_ID::VARCHAR = st.ENTITY_ID
WHERE st.ENTITY_LEVEL = 'UNIT';
