-- VW_ACTION_QUEUE — proactive at-risk work-queue for the app (flattened reasons for display).
CREATE OR REPLACE VIEW {{ target('VW_ACTION_QUEUE') }} AS
SELECT
  ENCOUNTER_ID, PATIENT_ID, UNIT_ID, RISK_SCORE, RISK_TIER,
  PRIMARY_REASON, ARRAY_TO_STRING(TOP_REASONS, '; ') AS ALL_REASONS,
  RECOMMENDED_ACTION, OWNING_TEAM, RECOMMENDED_CHANNEL
FROM {{ target('DT_ACTION_WORKQUEUE') }}
ORDER BY RISK_SCORE DESC;
