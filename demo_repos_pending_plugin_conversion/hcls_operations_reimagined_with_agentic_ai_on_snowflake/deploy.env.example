# =============================================================================
# deploy.env — Configuration for your Snowflake environment
# Copy this file to deploy.env and fill in your values.
# =============================================================================

# Snowflake Account (e.g., "xy12345" or "myorg-myaccount")
SNOWFLAKE_ACCOUNT=

# Snowflake username (for Docker registry login)
SNOWFLAKE_USER=

# App database and schema (where tables, data, and services live)
APP_DATABASE=AGENTIC_DENIED_CLAIMS_HANDLING
APP_SCHEMA=DENIED_CLAIMS

# Platform database (where Cortex Code Agent SDK service lives)
PLATFORM_DATABASE=CORTEX_CODE_DB

# Warehouse name
WAREHOUSE=COMPUTE_WH

# Compute pool name
COMPUTE_POOL=CORTEX_CODE_POOL

# Cortex host (your-account.snowflakecomputing.com)
CORTEX_HOST=

# Platform endpoint (filled after deploying the platform service)
# Get this from: SHOW ENDPOINTS IN SERVICE <PLATFORM_DATABASE>.SPCS.CORTEX_CODE_SERVICE;
# Use the ingress_url WITHOUT the https:// prefix
PLATFORM_ENDPOINT=

# Personal Access Token (create in Snowsight: User > Settings > Authentication)
SNOWFLAKE_PAT=
