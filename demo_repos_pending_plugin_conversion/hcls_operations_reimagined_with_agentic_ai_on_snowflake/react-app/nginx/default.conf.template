server {
    listen 3000;
    root /usr/share/nginx/html;
    index index.html;

    location /data/ {
        proxy_pass http://127.0.0.1:8000/data/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/agents {
        proxy_pass https://${PLATFORM_ENDPOINT}/agents;
        proxy_http_version 1.1;
        proxy_set_header Host ${PLATFORM_ENDPOINT};
        proxy_set_header Authorization "Snowflake Token=\"${CORTEX_CODE_PAT}\"";
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
    }

    location /api/ {
        proxy_pass https://${PLATFORM_ENDPOINT}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host ${PLATFORM_ENDPOINT};
        proxy_set_header Authorization "Snowflake Token=\"${CORTEX_CODE_PAT}\"";
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_ssl_server_name on;
        proxy_read_timeout 600s;
        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }
}
